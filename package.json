{
  "name": "playwright-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Industry-standard UI and API automation framework using Playwright and JavaScript",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:ui": "playwright test tests/ui --grep @ui",
    "test:api": "playwright test tests/api --grep @api",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:all": "playwright test",
    "test:report": "playwright show-report",
    "quality": "npm run lint && npm run format:check",
    "quality:ci": "npm run quality && npm audit --audit-level=high",
    "prepare": "husky"
  },
  "dependencies": {
    "dotenv": "^18.0.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
